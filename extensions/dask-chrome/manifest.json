{
  "manifest_version": 3,
  "name": "D-ASK Browser Control",
  "version": "1.0.0",
  "description": "Lets your local D-ASK assistant read and act in this Chrome profile after you approve it in the D-ASK HUD. Talks only to the D-ASK native host on this computer (no network, no debugging port).",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "D-ASK",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "116"
}