{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "DAsk": "Debug"
    }
  },
  "Daemon": {
    "PipeName": "d-ask-ipc-v1",
    "TelemetryIntervalMs": 1000,
    "HeartbeatIntervalMs": 5000,
    "MaxConnectedClients": 4,
    "HandshakeTimeoutMs": 5000,
    "AllowedClientImagePaths": [
      "../../../../hud-native/target/debug/hud-native.exe",
      "../../../../hud-native/target/release/hud-native.exe"
    ]
  },
  "ResourceManager": {
    "WarningAvailableMemoryMB": 2500,
    "CriticalAvailableMemoryMB": 1800,
    "CpuThrottleThresholdPercent": 85,
    "MinModelLoadHeadroomMB": 2000,
    "TrackSubsystemAllocations": true
  },
  "AgentHost": {
    "Enabled": true,
    "AutoStart": false,
    "NodePath": "node",
    "EntryPath": "dist/agent-host/agent/host/stdioHost.js",
    "ExperimentalCapabilityCheck": false,
    "ExperimentalModelTiers": false,
    "DesktopActionExecution": true
  }
}
