<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="System.Text.Encodings.Web" Version="10.0.13" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DAsk.Daemon">
      <HintPath>..\..\src\DAsk.Daemon\bin\Debug\net8.0\DAsk.Daemon.dll</HintPath>
    </Reference>
    <Reference Include="DAsk.Protocol">
      <HintPath>..\..\src\DAsk.Protocol\bin\Debug\net8.0\DAsk.Protocol.dll</HintPath>
    </Reference>
    <None Include="..\..\src\DAsk.Daemon\bin\Debug\net8.0\e_sqlite3.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>e_sqlite3.dll</Link>
    </None>
  </ItemGroup>

</Project>
